{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e3d-setup-generator/config.schema.json",
  "title": "E3D Setup Generator config",
  "type": "object",
  "required": ["schema", "project", "mdbs", "dbDefaults", "attributes", "combination", "templates", "zoneRules", "referenceDbs", "output"],
  "properties": {
    "schema": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["code", "name", "target", "filePrefix", "packageName", "lineEnding"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$" },
        "name": { "type": "string" },
        "target": { "type": "string" },
        "filePrefix": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
        "packageName": { "type": "string", "pattern": "^[^\\\\/:*?\"<>|]+\\.zip$" },
        "lineEnding": { "enum": ["CRLF", "LF"] }
      }
    },
    "mdbs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "default"],
        "properties": { "name": { "type": "string", "pattern": "^/[A-Za-z0-9_-]+$" }, "default": { "type": "boolean" } }
      }
    },
    "dbDefaults": {
      "type": "object", "required": ["type", "access", "claim"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z]+$", "examples": ["DESI", "CATA", "DRAFT", "ISODRAFT"] },
        "access": { "enum": ["MULTIWRITE", "UPDATE", "CONTROLLED"] },
        "claim": { "enum": ["IMPLICIT", "EXPLICIT"] }
      }
    },
    "attributes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "role", "columns", "rows"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "role": { "enum": ["team", "user", "separator", "none"] },
          "columns": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "required": ["id", "name", "type"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
                "name": { "type": "string" },
                "type": { "enum": ["text", "number", "boolean", "ref", "refList"] },
                "required": { "type": "boolean" },
                "target": { "type": "string" }
              },
              "allOf": [{ "if": { "properties": { "type": { "enum": ["ref", "refList"] } } }, "then": { "required": ["target"] } }]
            }
          },
          "rows": {
            "type": "array",
            "items": { "type": "object", "required": ["kode", "desc"], "properties": { "kode": { "type": "string" }, "desc": { "type": "string" } } }
          }
        }
      }
    },
    "combination": {
      "type": "object", "required": ["rowAttr", "colAttr", "mode", "mdb"],
      "properties": {
        "rowAttr": { "type": "string" },
        "colAttr": { "type": "string" },
        "groupBy": { "type": "string" },
        "mode": { "enum": ["all", "matrix", "condition"] },
        "excluded": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 } },
        "condition": { "$ref": "#/$defs/when" },
        "mdb": { "type": "string", "pattern": "^/" }
      }
    },
    "templates": {
      "type": "object",
      "required": ["dbName", "dbDesc", "dbNo", "mdbPos", "site", "teamsFolder", "teamsFile", "discFolder", "b1File", "b2File", "b3File", "refFolder", "refFile", "fixupFolder", "fixupFile", "registerFile"],
      "additionalProperties": { "type": "string" }
    },
    "zoneRules": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "when", "patterns"],
        "properties": {
          "id": { "type": "string" },
          "when": { "$ref": "#/$defs/when" },
          "forEach": { "type": "string" },
          "patterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source": { "type": "string" }
        }
      }
    },
    "referenceDbs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["db", "pos", "active"],
        "properties": {
          "db": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
          "pos": { "type": ["integer", "null"] },
          "active": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "inUse": {
      "type": "object",
      "properties": {
        "teams": { "type": "array", "items": { "type": "string" } },
        "dbs": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "number": { "type": ["integer", "null"] } } } },
        "source": { "type": "string" },
        "importedAt": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "includeReadme": { "type": "boolean" },
        "includeRegister": { "type": "boolean" },
        "includeConfig": { "type": "boolean" },
        "includeReference": { "type": "boolean" },
        "includeFixup": { "type": "boolean" },
        "includeExistingTeamsBlock": { "type": "boolean" },
        "split": { "enum": ["perDiscipline", "perStep"] }
      }
    }
  },
  "$defs": {
    "when": {
      "type": "array",
      "items": {
        "type": "object", "required": ["token", "op", "value"],
        "properties": {
          "token": { "type": "string" },
          "op": { "enum": ["eq", "ne", "in"] },
          "value": {}
        }
      }
    }
  }
}
