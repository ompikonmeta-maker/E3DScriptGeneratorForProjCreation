  "combination": {
    "rowAttr": "disiplin",
    "colAttr": "area",
    "groupBy": "grup",
    "mode": "matrix",
    "excluded": [],
    "mdb": "/MDB-ZRF"
  },
  "templates": {
    "dbName": "{Disiplin.team.kode}/DESI-{Disiplin.kode}-{Area.kode}{Area.fungsi.kode}",
    "dbDesc": "DB for {Disiplin.desc} - {Area.desc}",
    "dbNo": "10000 + {Disiplin.urutan} * 100 + {Area.slot}",
    "mdbPos": "{Disiplin.mdbMulai} + {INDEX} - 1",
    "site": "/{Disiplin.kode}-{Area.kode}{Area.fungsi.kode}",
    "sepDiscipline": "/----{Disiplin.desc|upper}----",
    "sepGroup": "/{Disiplin.kode}----{Grup.kode}----",
    "teamsFolder": "00-TEAMS",
    "teamsFile": "{PROJECT.filePrefix}00-TEAMS-ADMIN.mac",
    "discFolder": "{Disiplin.urutan|pad:2}-{Disiplin.kode}-{Disiplin.team.kode}",
    "b1File": "{PROJECT.filePrefix}{Disiplin.urutan|pad:2}-{Disiplin.kode}-B1-CREATE-DB-MDB-ADMIN.mac",
    "b2File": "{PROJECT.filePrefix}{Disiplin.urutan|pad:2}-{Disiplin.kode}-B2-SITES-DESIGN.mac",
    "b3File": "{PROJECT.filePrefix}{Disiplin.urutan|pad:2}-{Disiplin.kode}-B3-ZONES-DESIGN.mac",
    "refFolder": "90-REFERENCE",
    "refFile": "{PROJECT.filePrefix}90-REF-MDB-ADMIN.mac",
    "fixupFolder": "99-FIXUP",
    "fixupFile": "{PROJECT.filePrefix}99-MDB-REORDER-ADMIN.mac",
    "registerFile": "{PROJECT.code}-E3D-Register.xlsx"
  },
  "zoneRules": [
    {
      "id": "pipe-fluid",
      "when": [
        {
          "token": "Disiplin.kode",
          "op": "eq",
          "value": "L"
        },
        {
          "token": "Area.fungsi.kode",
          "op": "ne",
          "value": "X"
        }
      ],
      "forEach": "fluid",
      "patterns": [
        "{SITE}-PIPE-{Fluid.kode}"
      ],
      "source": "doc 3.9 B"
    },
    {
      "id": "equi",
      "when": [
        {
          "token": "Disiplin.kode",
          "op": "eq",
          "value": "R"
        },
        {
          "token": "Area.fungsi.kode",
          "op": "ne",
          "value": "X"
        }
      ],
      "patterns": [
        "{SITE}-EQUI",
        "{SITE}-NIEQP"
      ],
      "source": "doc 3.9 D"
    },
    {
      "id": "handling-safety",
      "when": [
        {
          "token": "Disiplin.kode",
          "op": "in",
          "value": [
            "M",
            "S"
          ]
        },
        {
          "token": "Area.fungsi.kode",
          "op": "ne",
          "value": "X"
        }
      ],
      "patterns": [
        "{SITE}-EQUI",
        "{SITE}-NIEQP-TRAN",
        "{SITE}-NIEQP-LONG"
      ],
      "source": "doc 3.9 E/F"
    },
    {
      "id": "arch",
      "when": [
        {
          "token": "Disiplin.kode",
          "op": "eq",
          "value": "A"
        },
        {
          "token": "Area.fungsi.kode",
          "op": "ne",
          "value": "X"
        }
      ],
      "patterns": [
        "{SITE}-WALL"
      ],
      "source": "doc 3.9 G"
    },
    {
      "id": "hvac",
      "when": [
        {
          "token": "Disiplin.kode",
          "op": "eq",
          "value": "H"
        },
        {
          "token": "Area.fungsi.kode",
          "op": "ne",
          "value": "X"
        }
      ],
      "patterns": [
        "{SITE}-EQUI",
        "{SITE}-NIEQP",
        "{SITE}-DUCT"
      ],
      "source": "doc 3.9 H"
    },
    {
      "id": "dummy",
      "when": [
        {
          "token": "Area.fungsi.kode",
          "op": "eq",
          "value": "X"
        }
      ],
      "patterns": [
        "{SITE}-STRU",
        "{SITE}-EQUI"
      ],
      "source": "project addition 2026-10-21; see OPEN-ITEMS OI-01"
    }
  ],
